{
  "name": "organizador-de-concursos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/montar-artifact.mjs && vite build --mode web && node scripts/montar-web.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "node scripts/servir-preview.mjs",
    "radar:coletar": "node scripts/radar/coletar.ts --saida .cache/radar/oportunidades.json",
    "radar:mesclar": "node scripts/radar/mesclar.ts",
    "radar:amostra": "node scripts/radar/coletar.ts --amostra tests/unit/fixtures/pci-sudeste.html"
  },
  "dependencies": {
    "lucide-react": "1.48.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "pdfjs-dist": "3.11.174",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
